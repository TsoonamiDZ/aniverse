// Prisma schema for the Anime streaming catalog.
// Data source: okanime.xyz snapshot (2186 anime, 25866 episodes, 149216 watch links).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single anime series.
model Anime {
  /// Source-provided id (slug based), e.g. "one-piece"
  id           String    @id
  slug         String    @unique
  title        String
  pageUrl      String
  posterUrl    String
  episodeCount Int       @default(0)
  /// Total watch-source links aggregated across all episodes (denormalized for fast stats/sort)
  sourceCount  Int       @default(0)
  importedAt   DateTime  @default(now())
  episodes     Episode[]

  // ---- AniList (GraphQL) + MyAnimeList metadata enrichment ----
  anilistId       Int?
  malId           Int?     // AniList's idMal (links to MAL page)
  anilistUrl      String?
  malUrl          String?
  /// portrait poster, high-res (AniList coverImage extraLarge)
  coverImage      String?
  /// dominant hex color from AniList coverImage.color
  coverColor      String?
  /// WIDE banner image (AniList bannerImage) — used for the cinematic hero backdrop
  bannerImage     String?
  trailerYoutubeId String?
  trailerThumbnail String?
  titleRomaji     String?
  titleEnglish    String?
  titleJapanese   String?
  /// TV / MOVIE / OVA / ONA / SPECIAL / MUSIC / TV_SHORT (AniList format)
  animeType       String?
  /// Manga / Light Novel / Original / Game / etc.
  animeSource     String?
  malEpisodes     Int?
  /// FINISHED / RELEASING / NOT_YET_RELEASED / CANCELLED
  animeStatus     String?
  airing          Boolean?
  airedString     String?
  airedYear       Int?
  season          String? // WINTER / SPRING / SUMMER / FALL
  duration        Int?    // minutes per episode
  /// 0-100 (AniList averageScore)
  score           Int?
  popularity      Int?
  favorites       Int?
  synopsis        String?
  synopsisAr      String?
  studios         String? // comma-separated
  genres          String? // comma-separated
  genresAr        String? // comma-separated (Arabic)
  tags            String? // comma-separated (top tags)
  tagsAr          String? // comma-separated (Arabic, best-effort)
  nextEpisode     Int?
  nextEpisodeAirAt String?
  metaFetchedAt   DateTime?
  /// "ok" | "not_found" | "error"
  metaStatus      String?

  @@index([title])
  @@index([episodeCount])
  @@index([sourceCount])
  @@index([score])
  @@index([airedYear])
  @@index([popularity])
}

/// A single episode belonging to an anime.
model Episode {
  /// Source-provided id (slug based), e.g. "one-piece-episode-1"
  id             String    @id
  slug           String    @unique
  title          String
  animeId        String
  anime          Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeTitle     String
  /// Stored as a string because the source mixes ints ("1") and special labels.
  episodeNumber  String
  /// Numeric projection of episodeNumber for correct sorting (0 when non-numeric).
  episodeSort    Int       @default(0)
  episodePageUrl String
  animePageUrl   String
  posterUrl      String
  lastModified   String?
  importedAt     DateTime  @default(now())
  watchSources   WatchSource[]

  @@index([animeId])
  @@index([animeId, episodeSort])
  @@index([episodeSort])
}

/// One playable embed link for an episode (provider + quality).
model WatchSource {
  id           Int      @id @default(autoincrement())
  episodeId    String
  episode      Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider     String
  quality      String
  label        String
  watchUrl     String
  providerHost String

  @@index([episodeId])
  @@index([provider])
  @@index([quality])
  @@index([episodeId, quality])
}
