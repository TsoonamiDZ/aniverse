// Prisma schema for the Anime streaming catalog.
// Data source: okanime.xyz snapshot (2186 anime, 25866 episodes, 149216 watch links).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single anime series.
model Anime {
  /// Source-provided id (slug based), e.g. "one-piece"
  id           String    @id
  slug         String    @unique
  title        String
  pageUrl      String
  posterUrl    String
  episodeCount Int       @default(0)
  /// Total watch-source links aggregated across all episodes (denormalized for fast stats/sort)
  sourceCount  Int       @default(0)
  importedAt   DateTime  @default(now())
  episodes     Episode[]

  // ---- MyAnimeList (Jikan v4) enrichment ----
  malId            Int?
  malUrl           String?
  malImageUrl      String? // webp large_image_url (higher-quality poster)
  trailerYoutubeId String?
  trailerEmbedUrl  String?
  titleEnglish     String?
  titleJapanese    String?
  /// TV / Movie / OVA / ONA / Special / Music
  animeType        String?
  /// Manga / Light Novel / Original / Game / etc.
  animeSource      String?
  /// MAL's reported episode count
  malEpisodes      Int?
  /// "Currently Airing" / "Finished Airing" / "Not yet aired"
  animeStatus      String?
  airing           Boolean?
  airedString      String?
  airedYear        Int?
  season           String?
  duration         String?
  ageRating        String?
  score            Float?
  scoredBy         Int?
  rank             Int?
  popularityRank   Int?
  members          Int?
  favorites        Int?
  synopsis         String?
  background       String?
  /// comma-separated names
  studios          String?
  genres           String?
  themes           String?
  demographics     String?
  producers        String?
  licensors        String?
  metaFetchedAt    DateTime?
  /// "ok" | "not_found" | "error"
  metaStatus       String?

  @@index([title])
  @@index([episodeCount])
  @@index([sourceCount])
  @@index([score])
  @@index([airedYear])
}

/// A single episode belonging to an anime.
model Episode {
  /// Source-provided id (slug based), e.g. "one-piece-episode-1"
  id             String    @id
  slug           String    @unique
  title          String
  animeId        String
  anime          Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeTitle     String
  /// Stored as a string because the source mixes ints ("1") and special labels.
  episodeNumber  String
  /// Numeric projection of episodeNumber for correct sorting (0 when non-numeric).
  episodeSort    Int       @default(0)
  episodePageUrl String
  animePageUrl   String
  posterUrl      String
  lastModified   String?
  importedAt     DateTime  @default(now())
  watchSources   WatchSource[]

  @@index([animeId])
  @@index([animeId, episodeSort])
  @@index([episodeSort])
}

/// One playable embed link for an episode (provider + quality).
model WatchSource {
  id           Int      @id @default(autoincrement())
  episodeId    String
  episode      Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider     String
  quality      String
  label        String
  watchUrl     String
  providerHost String

  @@index([episodeId])
  @@index([provider])
  @@index([quality])
  @@index([episodeId, quality])
}
